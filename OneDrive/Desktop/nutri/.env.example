# ─────────────────────────────────────────────────────────────
#  MindfulAI — Mental Health Agent  |  Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit the .env file to version control.
# ─────────────────────────────────────────────────────────────

# IBM Cloud API Key (get it from https://cloud.ibm.com/iam/apikeys)
IBM_API_KEY=your_ibm_api_key_here

# IBM Watsonx.ai Project ID (from https://dataplatform.cloud.ibm.com)
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Watsonx.ai regional endpoint
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite model ID (recommended: granite-3-3-8b-instruct)
GRANITE_MODEL_ID=ibm/granite-3-3-8b-instruct

# Flask secret key — use a long random string in production
FLASK_SECRET_KEY=change-me-use-a-secure-random-secret

# Flask environment: development | production
FLASK_ENV=development

# Server port
PORT=5000
